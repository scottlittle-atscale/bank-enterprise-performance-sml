{
  "model_name": "Bank Enterprise Performance",
  "database": "atscale-sales-demo",
  "schema": "BANK_ENTERPRISE_PERFORMANCE",
  "engine": "BigQuery",
  "_comment": "Curated enterprise-catalog metadata for the Bank unified performance model (galaxy schema: 7 conformed dimensions x 4 fact tables). This fixture represents metadata that ALREADY EXISTS in the enterprise data catalog -- descriptions, business glossary, governance classifications, and (critically) aggregation-semantics tags (semi-additive / ratio / additive-flow). The demo assumes this curation is done; AtScale consumes it to generate a governed SML model. Additivity tags come from data_profile.yaml + DDL comments in the use-case bundle. FKs come from erd.mmd (BigQuery keeps them as comments only, so the catalog is the source of join truth).",
  "glossary": [
    {
      "name": "End-of-Month Balance",
      "definition": "Deposit ledger balance as of the month-end snapshot date. Semi-additive: valid to sum across branches, products, and segments within a snapshot, but never across snapshot dates. Read as-of the latest snapshot."
    },
    {
      "name": "Average Daily Balance",
      "definition": "Mean daily ledger balance across the month for a deposit account group. Semi-additive; used for interest and profitability analysis."
    },
    {
      "name": "Account Count",
      "definition": "Number of open deposit accounts as of the snapshot. Semi-additive point-in-time count; do not sum across months."
    },
    {
      "name": "Accounts Opened",
      "definition": "New deposit accounts opened during the period. Additive period flow."
    },
    {
      "name": "Accounts Closed",
      "definition": "Deposit accounts closed during the period; the primary attrition signal. Additive period flow."
    },
    {
      "name": "Interest Expense",
      "definition": "Interest paid on deposits during the month. Additive period flow."
    },
    {
      "name": "Loan Amount Originated",
      "definition": "Principal booked at loan origination. Additive; recognized in the origination month."
    },
    {
      "name": "Current Loan Balance",
      "definition": "Outstanding principal on a consumer loan as of the current month. As-of state per loan, not a monthly roll-forward."
    },
    {
      "name": "Interest Rate",
      "definition": "Note rate on a consumer loan, in percent. Ratio; average across loans, never sum."
    },
    {
      "name": "Loan-to-Value",
      "definition": "Loan principal divided by collateral value at origination, as a ratio. Average, never sum."
    },
    {
      "name": "Delinquency Status",
      "definition": "As-of bucket for a consumer loan: Current, 30 DPD, 60 DPD, 90+ DPD."
    },
    {
      "name": "Loan Vintage",
      "definition": "Origination year-month (YYYY-MM) cohort of a loan; used for vintage delinquency curves."
    },
    {
      "name": "Payment Fee Revenue",
      "definition": "Treasury-management and payments fee revenue earned in the activity month. Additive period flow."
    },
    {
      "name": "Payment Volume",
      "definition": "Dollar value of payments processed in the activity month. Additive period flow."
    },
    {
      "name": "Transaction Count",
      "definition": "Number of payment transactions in the activity month. Additive period flow."
    },
    {
      "name": "Commitment Amount",
      "definition": "Total committed credit on a CRE/C&I facility as of the snapshot. Semi-additive balance; do not sum across snapshots."
    },
    {
      "name": "Outstanding Balance",
      "definition": "Drawn balance on a facility as of the snapshot. Semi-additive balance; read as-of snapshot."
    },
    {
      "name": "Undrawn Amount",
      "definition": "Committed but undrawn credit as of the snapshot (commitment minus outstanding). Semi-additive."
    },
    {
      "name": "Interest Income",
      "definition": "Interest income accrued on a facility during the month. Additive period flow."
    },
    {
      "name": "Net Interest Margin (bps)",
      "definition": "Net interest margin in basis points for a facility. Ratio; aggregate with average, never sum."
    },
    {
      "name": "Regulatory Classification",
      "definition": "Supervisory credit classification: Pass, Criticized, or Classified. Classified plus non-accrual drives non-performing analysis."
    },
    {
      "name": "Non-Performing",
      "definition": "Flag indicating a facility is non-performing (typically Substandard/Doubtful and/or non-accrual)."
    },
    {
      "name": "Line of Business",
      "definition": "Bank reporting line of business: Retail Deposits, Consumer Lending, Commercial Payments, Commercial Real Estate, Middle Market Lending. Rolls up to segment (Consumer Bank / Commercial Bank)."
    },
    {
      "name": "Region",
      "definition": "Bank geographic region conformed across all lines of business: Great Lakes, Northeast, Pacific, Rocky Mountains."
    },
    {
      "name": "Customer Segment",
      "definition": "Relationship segmentation. Consumer: Mass Market, Mass Affluent, Private / HNW, Small Business. Commercial: Middle Market, Corporate, Institutional."
    }
  ],
