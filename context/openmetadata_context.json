  "glossary": [
    {
      "name": "Account Count",
      "fqn": "BankBusinessGlossary.Account Count",
      "description": "Number of open deposit accounts as of the snapshot. Semi-additive point-in-time count; do not sum across months."
    },
    {
      "name": "Accounts Closed",
      "fqn": "BankBusinessGlossary.Accounts Closed",
      "description": "Deposit accounts closed during the period; the primary attrition signal. Additive period flow."
    },
    {
      "name": "Accounts Opened",
      "fqn": "BankBusinessGlossary.Accounts Opened",
      "description": "New deposit accounts opened during the period. Additive period flow."
    },
    {
      "name": "Average Daily Balance",
      "fqn": "BankBusinessGlossary.Average Daily Balance",
      "description": "Mean daily ledger balance across the month for a deposit account group. Semi-additive; used for interest and profitability analysis."
    },
    {
      "name": "Commitment Amount",
      "fqn": "BankBusinessGlossary.Commitment Amount",
      "description": "Total committed credit on a CRE/C&amp;I facility as of the snapshot. Semi-additive balance; do not sum across snapshots."
    },
    {
      "name": "Current Loan Balance",
      "fqn": "BankBusinessGlossary.Current Loan Balance",
      "description": "Outstanding principal on a consumer loan as of the current month. As-of state per loan, not a monthly roll-forward."
    },
    {
      "name": "Customer Segment",
      "fqn": "BankBusinessGlossary.Customer Segment",
      "description": "Relationship segmentation. Consumer: Mass Market, Mass Affluent, Private / HNW, Small Business. Commercial: Middle Market, Corporate, Institutional."
    },
    {
      "name": "Delinquency Status",
      "fqn": "BankBusinessGlossary.Delinquency Status",
      "description": "As-of bucket for a consumer loan: Current, 30 DPD, 60 DPD, 90&#43; DPD."
    },
    {
      "name": "End-of-Month Balance",
      "fqn": "BankBusinessGlossary.End-of-Month Balance",
      "description": "Deposit ledger balance as of the month-end snapshot date. Semi-additive: valid to sum across branches, products, and segments within a snapshot, but never across snapshot dates. Read as-of the latest snapshot."
    },
    {
      "name": "Interest Expense",
      "fqn": "BankBusinessGlossary.Interest Expense",
      "description": "Interest paid on deposits during the month. Additive period flow."
    },
    {
      "name": "Interest Income",
      "fqn": "BankBusinessGlossary.Interest Income",
      "description": "Interest income accrued on a facility during the month. Additive period flow."
    },
    {
      "name": "Interest Rate",
      "fqn": "BankBusinessGlossary.Interest Rate",
      "description": "Note rate on a consumer loan, in percent. Ratio; average across loans, never sum."
    },
    {
      "name": "Line of Business",
      "fqn": "BankBusinessGlossary.Line of Business",
      "description": "Bank reporting line of business: Retail Deposits, Consumer Lending, Commercial Payments, Commercial Real Estate, Middle Market Lending. Rolls up to segment (Consumer Bank / Commercial Bank)."
    },
    {
      "name": "Loan Amount Originated",
      "fqn": "BankBusinessGlossary.Loan Amount Originated",
      "description": "Principal booked at loan origination. Additive; recognized in the origination month."
